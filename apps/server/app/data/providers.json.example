    },
    {
      "id": "ollama",
      "name": "Ollama (本地)",
      "api_url": "http://localhost:11434/v1/chat/completions",
      "api_key": "",
      "model": "qwen2.5:7b",
      "enabled": false,
      "extra": {
        "temperature": 0.7,
        "max_tokens": 2048
      },
      "api_type": "openai"
    },
    {
      "id": "minimax",
      "name": "MiniMax",
      "api_url": "https://api.minimax.chat/v1/text/chatcompletion_v2",
      "api_key": "${MINIMAX_API_KEY}",
      "model": "MiniMax-Text-01",
      "enabled": false,
      "extra": {
        "temperature": 0.7,
        "max_tokens": 2048
      },
      "api_type": "openai"
    },
    {
      "id": "minimax-m2.7-highspeed",
      "name": "MiniMax-M2.7-highspeed",
      "api_url": "https://v2.aicodee.com/v1",
      "api_key": "${MINIMAX_API_KEY}",
      "model": "MiniMax-M2.7-highspeed",
      "enabled": false,
      "extra": {},
      "api_type": "openai"
    }
  ]
}