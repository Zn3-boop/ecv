# LLM 配置：智谱 AI (BigModel)
LLM_API_KEY=55625898459b4606ac86ba085ce4cba9.RUzNXcqLrLqAUW9s
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 使用智谱 AI 模型
LLM_MODEL=glm-4-flash
LLM_TIMEOUT_SECONDS=45
LLM_APP_NAME=AI Desktop Agent
LLM_HTTP_REFERER=http://localhost:3000
LLM_MIN_INTERVAL_SECONDS=0.1
LLM_CACHE_TTL_SECONDS=180
LLM_CACHE_MAX_ENTRIES=128
LLM_REVIEW_ENABLED=false

# ============================================
# 语音：使用 Faster-Whisper 本地识别
# ============================================
VOICE_PROVIDER=local_whisper
VOICE_API_KEY=any

# TTS 走本地 Edge-TTS API（5050）
VOICE_BASE_URL=http://127.0.0.1:5050/v1

# STT 走本地 Faster-Whisper（5051）
VOICE_STT_BASE_URL=http://127.0.0.1:5051/v1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=zh-CN-XiaoyiNeural

# Faster-Whisper 配置（本地识别，无需 STT API）
LOCAL_WHISPER_MODEL_SIZE=small
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_LANGUAGE=zh

VOICE_TIMEOUT_SECONDS=60

# 兼容旧配置（如果部分代码仍读取 OPENAI_*）
OPENAI_API_KEY=any
OPENAI_BASE_URL=http://127.0.0.1:5050/v1
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=zh-CN-XiaoyiNeural
OPENAI_TIMEOUT_SECONDS=90
VOICE_BRIDGE_PORT=5050

# CORS 配置
ENV=development
CORS_ALLOW_ALL=true