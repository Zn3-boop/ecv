{
  "name": "ai-desktop-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "onnxruntime-node"
    ]
  },
  "scripts": {
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:desktop:electron": "cd apps/desktop && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 AGENT_SERVER_URL=http://127.0.0.1:8000 electron .",
    "dev:server": "python -m uvicorn app.main:app --app-dir apps/server --reload --host 127.0.0.1 --port 8000",
    "dev:full": "cmd /c \"start cmd /k pnpm dev:server && start cmd /k pnpm dev:desktop && start cmd /k pnpm dev:desktop:electron\""
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^37.4.0"
  }
}
